# PROD environment — mirrors what the deployed frontend builds with (Vercel).
# `next build` locally produces a production-equivalent bundle from this file;
# on Vercel, dashboard variables still win over anything listed here.
# Secrets (Sentry auth token) are NOT kept here — they stay in the Vercel project.

# Canonical apex origin drives SEO metadata, sitemap, robots, llms.txt.
NEXT_PUBLIC_SITE_URL=https://anaquran.com

# Server-side /api proxy target (MonsterASP host). Read at build time.
API_ORIGIN=https://anaquran.runasp.net
# Empty = same-origin through the proxy above.
NEXT_PUBLIC_BACKEND_URL=

# Direct SignalR WebSocket origin: the /api rewrite does not proxy upgrades.
NEXT_PUBLIC_REALTIME_URL=https://anaquran.runasp.net

# Self-hosted Jitsi (Oracle VPS). Temporary sslip.io hostname until a DNS name
# is pointed at the box; domain only, no scheme.
NEXT_PUBLIC_JITSI_DOMAIN=meet.143-47-237-128.sslip.io

# Phone-OTP login on /login. Off by default; set to true (here or in the
# Vercel dashboard, which wins) to show the mobile-number sign-in tab.
NEXT_PUBLIC_PHONE_OTP_LOGIN=

NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# DSNs are set in the Vercel dashboard; empty here keeps local prod builds quiet.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=ana-quran-academy
SENTRY_PROJECT=ana-quran-academy-web
SENTRY_AUTH_TOKEN=
