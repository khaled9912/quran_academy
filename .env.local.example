NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_BACKEND_URL=http://localhost:5001
# Production only: proxy /api/* to this API origin (next.config.mjs). When set,
# leave NEXT_PUBLIC_BACKEND_URL empty so the browser calls the same origin.
API_ORIGIN=
# Optional: SignalR hub origin (e.g. https://anaquran.runasp.net). The hub
# socket must reach the API directly because the /api rewrite does not proxy
# WebSocket upgrades. Falls back to the URL in GET /api/realtime/ticket.
NEXT_PUBLIC_REALTIME_URL=
# Optional: Jitsi domain for lesson rooms (defaults to meet.jit.si)
NEXT_PUBLIC_JITSI_DOMAIN=meet.jit.si

# Optional: Sentry error monitoring (disabled when the DSN is empty)
# Create the project under the org slug: ana-quran-academy
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Only needed to upload source maps during `next build`
# Recommended frontend project slug: ana-quran-academy-web
SENTRY_ORG=ana-quran-academy
SENTRY_PROJECT=ana-quran-academy-web
SENTRY_AUTH_TOKEN=
