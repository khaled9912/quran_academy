# DEV environment — loaded automatically by `next dev` and local device tunnels.
# Machine-specific overrides stay in .env*.local (gitignored).
# Production values live in .env.production; the deployed hosts keep their own copy.

# Local API is direct on the desktop machine. This keeps the browser and SignalR
# socket on the real API origin instead of the Next.js proxy origin.
NEXT_PUBLIC_BACKEND_URL=http://localhost:5001
API_ORIGIN=http://localhost:5001

# Self-hosted Jitsi stack from ana-quran-infra running in local docker.
NEXT_PUBLIC_JITSI_DOMAIN=localhost:8443

# SignalR must connect directly to the API, not to the frontend's /api rewrite.
NEXT_PUBLIC_REALTIME_URL=http://localhost:5001

# Canonical origin for SEO metadata; localhost keeps absolute URLs valid in dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Error reporting is production-only.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=ana-quran-academy
SENTRY_PROJECT=ana-quran-academy-web
SENTRY_AUTH_TOKEN=
